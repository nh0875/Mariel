{
  "name": "vinoh-finanzas",
  "version": "1.0.0",
  "private": true,
  "description": "VINOH! Finanzas — sistema de finanzas, costos, stock y ventas para una empresa de vinos. Corre 100% local (localhost).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "iniciar": "node scripts/iniciar.mjs",
    "dev": "concurrently -k -n api,web -c yellow,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsx server/scripts/load-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/londrina-solid": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
